{
  "name": "@keyv/website",
  "version": "6.0.0-rc.1",
  "description": "Keyv Website",
  "repository": "https://github.com/jaredwray/keyv.git",
  "author": "Jared Wray <me@jaredwray.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test:ci": "echo 'no tests needed'",
    "test": "echo 'no tests needed'",
    "generate-docs": "tsx ./src/docs.ts",
    "build": "echo 'no build needed'",
    "website:build": "pnpm generate-docs && docula build --clean -s ./site -o ./dist",
    "build-serve": "pnpm clean && pnpm generate-docs && docula serve --build --clean -s ./site -o ./dist",
    "clean": "rimraf ./dist ./site/.cache",
    "website:serve": "pnpm generate-docs && docula serve --build --clean -s ./site -o ./dist",
    "website:dev": "pnpm generate-docs && docula serve --watch --clean -s ./site -o ./dist"
  },
  "devDependencies": {
    "docula": "^2.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12"
  }
}
